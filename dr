#!/usr/bin/env node

const [, , target, versionArg] = process.argv;
const DEFAULT_API_AUTHORIZATION =
  "Bearer bHCWl-mn7fMMRFdYfqmPTD7KP9XxjVYDDlEXBWBz";

if (!target) {
  console.error("Usage: dr <domain> [version (dr3|dr4)]");
  process.exit(1);
}

let parsedTarget;
try {
  const targetWithProtocol =
    target.startsWith("http://") || target.startsWith("https://")
      ? target
      : `https://${target}`;
  parsedTarget = new URL(targetWithProtocol).hostname;
} catch {
  console.error(`Invalid domain: ${target}`);
  process.exit(1);
}

const version =
  versionArg &&
  (versionArg.toLowerCase() === "dr4" || versionArg.toLowerCase() === "dr3")
    ? versionArg.toLowerCase()
    : "dr3";

const endpoint = new URL("https://api.ahrefs.com/v3/public/domain-rating-free");
endpoint.searchParams.set("target", parsedTarget);
endpoint.searchParams.set("version", version);

const headers = {
  accept: "application/json",
  authorization: DEFAULT_API_AUTHORIZATION,
  "user-agent": "dr-cli/0.1",
};

if (process.env.AHREFS_API_KEY) {
  headers["authorization"] = `Bearer ${process.env.AHREFS_API_KEY}`;
}

try {
  const response = await fetch(endpoint, {
    headers,
  });

  if (!response.ok) {
    console.error(`Request failed with ${response.status}`);
    process.exit(1);
  }

  const payload = await response.json();
  const domainRating = payload?.domain_rating?.domain_rating;

  if (typeof domainRating !== "number") {
    console.error("Unexpected response format");
    process.exit(1);
  }

  console.log(
    Number.isInteger(domainRating) ? domainRating : String(domainRating)
  );
} catch (error) {
  console.error(error instanceof Error ? error.message : "Request failed");
  process.exit(1);
}
