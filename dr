#!/usr/bin/env node

const [, , target] = process.argv;

if (!target) {
  console.error("Usage: da <domain>");
  process.exit(1);
}

let parsedTarget;
try {
  parsedTarget = new URL(`https://${target}`).hostname;
} catch {
  console.error(`Invalid domain: ${target}`);
  process.exit(1);
}

const endpoint = new URL("https://api.ahrefs.com/v3/public/domain-rating-free");
endpoint.searchParams.set("target", parsedTarget);

try {
  const response = await fetch(endpoint, {
    headers: {
      "accept": "application/json",
      "user-agent": "da-cli/0.1",
    },
  });

  if (!response.ok) {
    console.error(`Request failed with ${response.status}`);
    process.exit(1);
  }

  const payload = await response.json();
  const domainRating = payload?.domain_rating?.domain_rating;

  if (typeof domainRating !== "number") {
    console.error("Unexpected response format");
    process.exit(1);
  }

  console.log(Number.isInteger(domainRating) ? domainRating : String(domainRating));
} catch (error) {
  console.error(error instanceof Error ? error.message : "Request failed");
  process.exit(1);
}
